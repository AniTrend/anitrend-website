{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AniTrend/anitrend-website/blob/main/.github/security/dependency-risk.schema.json",
  "title": "AniTrend security-runner v1 PR assessment",
  "description": "Extended assessment, not authorization. The trusted validator independently compares live facts and requires a human attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessed_at",
    "repository",
    "pr_number",
    "pr_url",
    "base_sha",
    "head_sha",
    "changed_files",
    "dependency_changes",
    "advisory_aliases",
    "severity",
    "findings",
    "decision",
    "risk",
    "confidence",
    "update_type",
    "breaking_change_assessment",
    "breaking_change_evidence",
    "runtime_impact",
    "runtime_impact_evidence",
    "required_checks",
    "scans",
    "coverage_gaps",
    "manual_follow_up",
    "sources_checked",
    "automerge_allowed",
    "release_allowed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "anitrend.security-runner.v1"
    },
    "assessed_at": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "const": "AniTrend/anitrend-website"
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "pr_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependency_changes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "from",
          "to",
          "path",
          "ecosystem",
          "update_type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ecosystem": {
            "type": "string",
            "minLength": 1
          },
          "update_type": {
            "type": "string",
            "enum": [
              "semver-patch",
              "semver-minor",
              "semver-major",
              "digest",
              "non-semver",
              "unknown"
            ]
          }
        }
      }
    },
    "advisory_aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "moderate",
        "high",
        "critical",
        "unknown"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "aliases",
          "package",
          "path",
          "severity",
          "state",
          "targeted",
          "scope",
          "reachability_evidence"
        ],
        "properties": {
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "moderate",
              "high",
              "critical",
              "unknown"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "introduced",
              "pre-existing",
              "fixed",
              "mitigated",
              "unknown"
            ]
          },
          "targeted": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "reachability_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "decision": {
      "type": "string",
      "enum": [
        "approve",
        "neutral",
        "changes_requested"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "update_type": {
      "type": "string",
      "enum": [
        "semver-patch",
        "semver-minor",
        "semver-major",
        "digest",
        "non-semver",
        "unknown"
      ]
    },
    "breaking_change_assessment": {
      "type": "string",
      "enum": [
        "compatible",
        "breaking",
        "unknown"
      ]
    },
    "breaking_change_evidence": {
      "type": "string",
      "minLength": 1
    },
    "runtime_impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "runtime_impact_evidence": {
      "type": "string",
      "minLength": 1
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha",
          "result",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "result": {
            "type": "string",
            "enum": [
              "success",
              "failure",
              "pending",
              "skipped",
              "cancelled",
              "unknown"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        }
      },
      "uniqueItems": true
    },
    "scans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "scanner",
          "version",
          "advisory_data_timestamp",
          "scope",
          "tested_sha",
          "status",
          "introduced_findings",
          "url"
        ],
        "properties": {
          "surface": {
            "type": "string",
            "enum": [
              "resolved-dependencies",
              "code",
              "secrets",
              "container"
            ]
          },
          "scanner": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "advisory_data_timestamp": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "tested_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "introduced_findings": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        }
      },
      "uniqueItems": true
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "manual_follow_up": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "url"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "official-release-notes",
              "primary-advisory",
              "repository-policy",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        }
      },
      "uniqueItems": true
    },
    "automerge_allowed": {
      "type": "boolean"
    },
    "release_allowed": {
      "type": "boolean"
    }
  }
}
